@page
@model ToDoApp.View.Home.ListDetails
@{
    Layout = null;
    var listId = Request.Query["id"].ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ToDo List Details</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <style>
        :root{font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#111}
        body{margin:0;padding:18px;background:#f6f7fb}
        .container{max-width:1200px;margin:8px auto;padding:18px;background:#fff;border-radius:12px;box-shadow:0 8px 28px rgba(10,20,40,.06)}
        header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
        h1{margin:0;font-size:1.25rem}
        .controls{display:flex;gap:8px;align-items:center}
        input[type="text"]{padding:8px;border-radius:8px;border:1px solid #e6ecff;min-width:220px}
        .btn{padding:8px 12px;border-radius:8px;border:0;cursor:pointer}
        .btn-primary{background:#3b82f6;color:#fff}
        .btn-ghost{background:transparent;border:1px solid #e6eaf7}
        /* ensure consistent 4 columns layout that won't collapse */
        .board{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:16px}
        .column{background:#fbfdff;border-radius:10px;padding:10px;border:1px solid #eef3ff;min-height:180px;display:flex;flex-direction:column}
        .col-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
        .col-title{font-weight:600;font-size:0.95rem}
        .col-count{font-size:0.85rem;color:#6b7280}
        .col-add{padding:6px 8px;border-radius:8px;border:0;background:#eef2ff;cursor:pointer}
        .card{background:#fff;border-radius:8px;padding:10px;margin-bottom:8px;border:1px solid #f0f4ff;box-shadow:0 4px 10px rgba(10,20,50,.03);display:flex;justify-content:space-between;align-items:flex-start}
        .card .left{max-width:78%}
        .card .title{font-weight:600;margin-bottom:6px}
        .card .meta{font-size:0.85rem;color:#6b7280}
        .card .actions{display:flex;gap:6px}
        .small{font-size:.85rem;color:#6b7280}
        .status-select{padding:6px;border-radius:6px;border:1px solid #e8eefc;background:#fff}
        .empty{padding:12px;text-align:center;color:#6b7280}

        /* Modal styles */
        .modal-backdrop{position:fixed;inset:0;background:rgba(8,12,24,0.45);display:none;align-items:center;justify-content:center;z-index:60}
        .modal{width:520px;background:#fff;border-radius:10px;padding:16px;box-shadow:0 10px 40px rgba(10,20,50,.2)}
        .modal h3{margin:0 0 8px}
        .modal label{display:block;margin:8px 0 4px}
        .modal input, .modal textarea, .modal select{width:100%;padding:8px;border:1px solid #dde6fb;border-radius:6px;box-sizing:border-box}
        .modal .row{display:flex;gap:8px}
        .modal .row .col{flex:1}
        .modal .actions{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}
        .hidden{display:none}
    </style>
</head>
<body>
<div class="container">
    <header>
        <div>
            <h1>List: <span id="listTitle">Loading...</span></h1>
            <div class="small" id="listMeta"></div>
        </div>
        <div class="controls">
            <button id="backBtn" class="btn btn-ghost">Back</button>
        </div>
    </header>

    <div class="board" id="board">
        <!-- columns will be rendered here for each status -->
    </div>
</div>

<!-- Modal (inline) for creating a note -->
<div id="modalBackdrop" class="modal-backdrop" role="dialog" aria-hidden="true">
    <div class="modal" role="document" aria-labelledby="modalTitle">
        <h3 id="modalTitle">Create note</h3>
        <label for="modalTitleInput">Title</label>
        <input id="modalTitleInput" />
        <label for="modalContextInput">Context</label>
        <textarea id="modalContextInput" rows="6"></textarea>
        <div class="row" style="margin-top:8px">
            <div class="col">
                <label for="modalEndInput">End date (optional)</label>
                <input id="modalEndInput" type="datetime-local" />
            </div>
            <div class="col">
                <label for="modalStatusSelect">Status</label>
                <select id="modalStatusSelect">
                    <option value="1">Waiting</option>
                    <option value="2">In Process</option>
                    <option value="3">Disabled</option>
                    <option value="4">Completed</option>
                </select>
            </div>
        </div>
        <div class="actions">
            <button id="modalCancel" class="btn btn-ghost">Cancel</button>
            <button id="modalCreate" class="btn btn-primary">Create</button>
        </div>
    </div>
</div>

<script>
    // visible statuses (exclude None=0)
    const VisibleStatuses = [1,2,3,4];
    const statusNames = { 1:'Waiting',2:'In Process',3:'Disabled',4:'Completed' };

    const listId = "@listId";
    const listsEndpoint = '/api/TodoList';
    const todoApi = '/api/TodoNote';

    const board = document.getElementById('board');
    const backBtn = document.getElementById('backBtn');
    const listTitle = document.getElementById('listTitle');
    const listMeta = document.getElementById('listMeta');

    // modal elements
    const modalBackdrop = document.getElementById('modalBackdrop');
    const modalTitleInput = document.getElementById('modalTitleInput');
    const modalContextInput = document.getElementById('modalContextInput');
    const modalEndInput = document.getElementById('modalEndInput');
    const modalStatusSelect = document.getElementById('modalStatusSelect');
    const modalCancel = document.getElementById('modalCancel');
    const modalCreate = document.getElementById('modalCreate');

    function buildColumns(){
        board.innerHTML = '';
        VisibleStatuses.forEach(status =>{
            const col = document.createElement('div');
            col.className = 'column';
            col.dataset.status = status;
            col.innerHTML = `
                <div class="col-header">
                    <div style="display:flex;align-items:center;gap:8px"><div class="col-title">${statusNames[status]}</div><div class="col-count" data-count>0</div></div>
                    <button class="col-add" data-add-status="${status}">+ Add</button>
                </div>
                <div class="col-body"></div>`;
            board.appendChild(col);
        });

        // attach add handlers
        board.querySelectorAll('.col-add').forEach(btn =>{
            btn.addEventListener('click', ()=> openCreateModal(Number(btn.dataset.addStatus)));
        });
    }

    async function loadList(){
        try{
            const res = await fetch(`${listsEndpoint}/${listId}`);
            if(!res.ok) throw new Error('failed to load list');
            const list = await res.json();
            listTitle.textContent = list.name || 'Unnamed';
            listMeta.textContent = (list.count ?? 0) + ' tasks';
            // show columns even before todos arrive
            buildColumns();
            await loadTodos();
        }catch(e){ listTitle.textContent = 'Error loading list'; console.error(e); }
    }

    async function loadTodos(){
        try{
            const res = await fetch(`${listsEndpoint}/${listId}/todos`);
            if(!res.ok){
                const txt = await res.text();
                console.error('loadTodos: bad response', res.status, txt);
                throw new Error('failed to load todos');
            }

            // parse JSON safely
            const data = await res.json();
            // normalize array shapes: accept array or { todos: [...]} etc.
            let items = Array.isArray(data) ? data : (Array.isArray(data.todos) ? data.todos : (Array.isArray(data.items) ? data.items : []));
            renderBoard(items);
        }catch(e){ board.innerHTML = '<div class="empty">Could not load tasks</div>'; console.error('loadTodos error', e); }
    }

    function renderBoard(items){
        // ensure columns exist
        buildColumns();
        const buckets = {1:[],2:[],3:[],4:[]};
        if(!Array.isArray(items)) items = [];

        items.forEach(it=>{
            const s = (it.status == null) ? 0 : Number(it.status);
            if(s in buckets) buckets[s].push(it);
        });

        Object.keys(buckets).forEach(statusKey =>{
            const col = board.querySelector(`.column[data-status='${statusKey}']`);
            const body = col.querySelector('.col-body');
            body.innerHTML = '';

            buckets[statusKey].forEach(item => {
                const card = document.createElement('div');
                card.className = 'card';
                card.dataset.id = item.id;
                card.innerHTML = `
                    <div class="left">
                        <div class="title">${escapeHtml(item.title)}</div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
                        <select class="status-select" aria-label="Change status">
                            ${VisibleStatuses.map(s => `<option value="${s}">${statusNames[s]}</option>`).join('')}
                        </select>
                        <div class="actions" style="display:flex;gap:6px;margin-top:6px">
                            <button class="btn btn-ghost btn-edit">Edit</button>
                            <button class="btn btn-ghost btn-delete">Delete</button>
                        </div>
                    </div>`;

                const sel = card.querySelector('.status-select');
                sel.value = (item.status == null) ? String(VisibleStatuses[0]) : String(item.status);

                sel.addEventListener('change', async (e)=>{
                    const newStatus = Number(e.target.value);
                    try{ await updateTodoStatus(item.id, newStatus); await loadTodos(); }catch(err){console.error(err);}                });

                card.querySelector('.btn-edit').addEventListener('click', async ()=>{
                    const newTitle = prompt('Edit task title', item.title);
                    if(newTitle!=null && newTitle.trim()!==''){
                        try{ await updateTodoContent(item.id, newTitle.trim()); await loadTodos(); }catch(err){console.error(err);}                    }
                });

                card.querySelector('.btn-delete').addEventListener('click', async ()=>{
                    if(!confirm('Delete this task?')) return;
                    try{ await deleteTodo(item.id); await loadTodos(); }catch(err){console.error(err);}                });

                body.appendChild(card);
            });

            const countEl = col.querySelector('[data-count]');
            countEl.textContent = buckets[statusKey].length;
        });
    }

    // API usage adapted to TodoNoteController
    async function createTodo(title, endDate, status){
        try{
            const qs = [];
            if(title) qs.push('context=' + encodeURIComponent(title));
            if(endDate) qs.push('endDate=' + encodeURIComponent(endDate));
            const query = qs.length ? ('?' + qs.join('&')) : '';
            const res = await fetch(`${todoApi}/${listId}${query}`, { method: 'POST' });
            if(!res.ok){ const t = await res.text(); console.error('createTodo failed', res.status, t); throw new Error('create todo failed'); }
            const created = await res.json();
            // set status if needed (API creates with None by default)
            if(typeof status === 'number' && status !== 0){
                await updateTodoStatus(created.id, status);
            }
            await loadTodos();
        }catch(e){alert('Unable to add todo'); console.error(e);}    }

    async function updateTodoStatus(id, status){
        const res = await fetch(`${todoApi}/${id}/${status}`, { method: 'PATCH' });
        if(!res.ok){ const t = await res.text(); console.error('updateTodoStatus failed', res.status, t); throw new Error('status update failed'); }
    }

    async function updateTodoContent(id, content){
        const res = await fetch(`${todoApi}/${id}/${encodeURIComponent(content)}`, { method: 'PATCH' });
        if(!res.ok){ const t = await res.text(); console.error('updateTodoContent failed', res.status, t); throw new Error('content update failed'); }
    }

    async function deleteTodo(id){
        const res = await fetch(`${todoApi}/${id}`, { method:'DELETE' });
        if(!res.ok){ const t = await res.text(); console.error('deleteTodo failed', res.status, t); throw new Error('delete failed'); }
    }

    // modal controls
    function openCreateModal(status){
        modalTitleInput.value = '';
        modalContextInput.value = '';
        modalEndInput.value = '';
        modalStatusSelect.value = String(status);
        modalBackdrop.style.display = 'flex';
        modalBackdrop.setAttribute('aria-hidden','false');
        modalTitleInput.focus();
    }

    function closeCreateModal(){
        modalBackdrop.style.display = 'none';
        modalBackdrop.setAttribute('aria-hidden','true');
    }

    modalCancel.addEventListener('click', ()=> closeCreateModal());
    modalBackdrop.addEventListener('click', (e)=>{ if(e.target === modalBackdrop) closeCreateModal(); });

    modalCreate.addEventListener('click', async ()=>{
        const title = modalTitleInput.value.trim();
        const context = modalContextInput.value.trim();
        const end = modalEndInput.value ? new Date(modalEndInput.value).toISOString() : null;
        const status = Number(modalStatusSelect.value) || VisibleStatuses[0];
        const payloadTitle = title || context || '';
        await createTodo(payloadTitle, end, status);
        closeCreateModal();
    });

    function escapeHtml(str){ if(!str) return ''; return String(str).replace(/[&"'<>]/g, s => ({'&':'&amp;','"':'&quot;',"'":'&#39;','<':'&lt;','>':'&gt;'}[s])); }

    backBtn.addEventListener('click', ()=> window.location.href = '/');

    // initial
    loadList();
</script>
</body>
</html>