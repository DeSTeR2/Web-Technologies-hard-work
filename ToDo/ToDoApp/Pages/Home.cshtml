@page
@model ToDoApp.View.Home.Home

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/images/logo.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>To‑Do — Home</title>
    <style>
        :root{font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#111}
        body{margin:0;padding:0;background:#f6f7fb}
        .container{max-width:1100px;margin:36px auto;padding:24px;background:#fff;border-radius:12px;box-shadow:0 6px 22px rgba(20,20,50,.06)}
        header{display:flex;align-items:center;justify-content:space-between}
        h1{margin:0;font-size:1.6rem}
        .new-todo{display:flex;gap:8px;margin-top:18px}
        .btn{padding:8px 12px;border-radius:8px;border:0;cursor:pointer}
        .btn-primary{background:#3b82f6;color:#fff}
        .btn-ghost{background:transparent;border:1px solid #e3e8f0}
        .btn-small{padding:6px 8px;font-size:.9rem}
        .flex{display:flex;gap:12px;align-items:center}
        .lists{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}
        .list-card{min-width:200px;max-width:260px;padding:12px;border-radius:10px;border:1px solid #eef2ff;background:#fbfdff;box-shadow:0 4px 10px rgba(10,20,50,.03)}
        .list-card h3{margin:0 0 8px 0;font-size:1rem}
        .list-meta{font-size:.85rem;color:#6b7280}
        .list-actions{margin-top:10px;display:flex;gap:8px}
        .empty{padding:28px;text-align:center;color:#6b7280}
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
    <div class="container-fluid">
        <div class="d-flex align-items-center ms-auto">
            <img id="userIcon" src="/Account/Get/UserPhoto" class="rounded-circle me-2" style="width:32px; height:32px;" alt="User Icon">
            <span id="userName" class="me-3 fw-semibold"></span>
            <button id="logoutBtn" class="btn btn-outline-danger btn-sm">Logout</button>
        </div>
    </div>
</nav>

<div class="container" role="main">
    <header>
        <h1>My To‑Do Lists</h1>
        <div class="small meta">Manage lists — open a list to see its tasks.</div>
    </header>

    <section class="flex" style="margin-top:16px;">
        <input id="listNameInput" type="text" placeholder="New list name" aria-label="New list name" style="padding:8px;border-radius:8px;border:1px solid #e6ecff;flex:1;"/>
        <button id="createListBtn" class="btn btn-primary btn-small">Create List</button>
    </section>

    <section aria-label="Lists" style="padding:12px;">
        <div class="lists" id="listsContainer">
            <!-- list cards will be injected -->
        </div>
    </section>

    <template id="listCardTemplate">
        <div class="list-card" data-id="">
            <h3 class="list-title">List name</h3>
            <div class="list-meta small"><span class="count">0</span> tasks</div>
            <div class="list-actions">
                <button class="btn btn-primary btn-small btn-open">Open</button>
                <button class="btn btn-ghost btn-small btn-delete-list">Delete</button>
            </div>
        </div>
    </template>

</div>

<script src="~/js/home.js"></script>
<script src="~/js/account.js"></script>
</body>
</html>